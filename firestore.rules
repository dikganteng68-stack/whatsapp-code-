rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil: boleh dicek satu per satu lewat kode, tidak boleh didaftar semua.
    match /profiles/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update: if code.matches('[a-z0-9]{6,8}')
        && request.resource.data.keys().hasOnly(['name', 'ts', 'pic'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24
        && (!('pic' in request.resource.data)
            || (request.resource.data.pic is string && request.resource.data.pic.size() < 60000));
      allow delete: if false;
    }

    // Kotak masuk: siapa pun bisa mengirim, pesan tidak bisa diubah atau dihapus orang lain.
    match /inbox/{code}/m/{id} {
      allow create: if code.matches('[a-z0-9]{6,8}')
        && request.resource.data.keys().hasOnly(['from', 'name', 'c', 'ts'])
        && request.resource.data.c is string
        && request.resource.data.c.size() < 900000;
      allow read: if true;
      allow update, delete: if false;
    }

    // Storage kode: terbuka untuk semua orang (tanpa perlu DM). Tidak bisa diubah/dihapus dari klien.
    match /storage/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['by', 'code', 'lang', 'title', 'body', 'ts', 'img', 'kind'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 60
        && request.resource.data.body is string && request.resource.data.body.size() <= 100000
        && request.resource.data.by is string && request.resource.data.by.size() <= 24
        && request.resource.data.lang is string && request.resource.data.kind is string
        && (!('img' in request.resource.data)
            || (request.resource.data.img is string && request.resource.data.img.size() < 400000));
      allow update, delete: if false;
    }
  }
}
