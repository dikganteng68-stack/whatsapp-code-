rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil: boleh dicek satu per satu lewat kode, tidak boleh didaftar semua.
    match /profiles/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update: if code.matches('[a-z0-9]{8}')
        && request.resource.data.keys().hasOnly(['name', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24;
      allow delete: if false;
    }

    // Kotak masuk: siapa pun bisa mengirim, pesan tidak bisa diubah atau dihapus orang lain.
    match /inbox/{code}/m/{id} {
      allow create: if code.matches('[a-z0-9]{8}')
        && request.resource.data.keys().hasOnly(['from', 'name', 'c', 'ts'])
        && request.resource.data.c is string
        && request.resource.data.c.size() < 900000;
      allow read: if true;
      allow update, delete: if false;
    }
  }
}
